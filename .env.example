# Copy this file to .env and adjust the values. Do NOT commit your real .env.
#   cp .env.example .env
# Every variable maps 1:1 to a field in backend/app/config.py (Settings).

# --- App / storage -------------------------------------------------------
# APP_NAME=API Rate Limiter
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0

# --- Default rate-limit rule ---------------------------------------------
# LIMITER_STRATEGY: fixed_window | sliding_window_log | token_bucket
LIMITER_STRATEGY=fixed_window
RATE_LIMIT=10
WINDOW_SECONDS=60
TOKEN_BUCKET_CAPACITY=10
TOKEN_BUCKET_REFILL_RATE=1.0

# --- Failure behaviour ---------------------------------------------------
# FAIL_MODE=closed -> 503 if Redis is unavailable (safe default)
# FAIL_MODE=open   -> fall back to in-memory / let requests through
FAIL_MODE=closed

# --- Security ------------------------------------------------------------
# REQUIRED for the /admin API (admin is disabled when empty).
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=change-me-generate-a-long-random-token
# Only set true behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUSTED_PROXY_HEADERS=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# KEY_PREFIX=rl:v1

# --- Docker Compose only -------------------------------------------------
# Host port the API is published on (docker-compose.yml).
PORT=8000
